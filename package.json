{
  "name": "portfolio-cfn-infrastructure",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:template": "ts-node --files ./scripts/validate-template.ts",
    "validate:template:watch": "ts-node scripts?validate-all.ts",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:cfn-guard": "jest tests/integration --testTimeout=30000 --verbose",
    "test:production": "jest tests/integration/production-validation.test.ts --testTimeout=60000 --verbose",
    "test:discover": "jest tests/integration/cloudformation-validation.integration.test.ts --verbose",
    "discover:templates": "ts-node scripts/validation/discover-templates.ts",
    "test:all": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "chalk": "4.1.0",
    "ts-node": "^10.9.2"
  }
}
