{
  "name": "portfolio-cfn-infrastructure",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "jest --verbose",
    "validate:template": "ts-node --files ./scripts/validate-template.ts",
    "discover:templates": "ts-node scripts/validation/discover-templates.ts",
    "test:core": "jest tests/templates/core/ --verbose",
    "test:compute": "jest tests/templates/compute.test.ts --verbose",
    "test:networking": "jest tests/templates/networking.test.ts --verbose",
    "test:security": "jest tests/templates/security-analysis.test.ts",
    "test:pipelines": "jest tests/templates/pipelines.test.ts --verbose",
    "test:templates": "jest tests/templates/ --verbose",
    "test:comprehensive": "jest tests/templates/integration/comprehensive.test.ts --verbose",
    "test:discovery": "jest tests/templates/discovery.test.ts --verbose",
    "test:validation-patterns": "jest tests/templates/validation-patterns.test.ts --verbose",
    "test:critical": "jest tests/templates/critical/ --verbose",
    "analyze:security": "jest tests/templates/security-analysis.test.ts --verbose",
    "analyze:rules": "jest tests/templates/rules-verification.test.ts --verbose",
    "test:helpers": "jest tests/helpers/ --verbose",
    "test:cfn-guard": "jest tests/helpers/cfn-guard-runner.test.ts",
    "health-check": "yarn test:core && yarn test:critical && echo '✅ Infrastructure testing setup is healthy!'"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "chalk": "4.1.0",
    "ts-node": "^10.9.2"
  }
}
