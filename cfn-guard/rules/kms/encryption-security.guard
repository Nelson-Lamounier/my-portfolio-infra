# Dedicated Encryption Security Rules

# KMS Key Policy Security
rule kms_key_policy_least_privilege {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            Effect == "Allow" << KMS policy statements should be explicit Allow >>
            Action exists << KMS policy statements must specify actions >>
            when Action is_list {
                Action[*] != "kms:*" << Avoid wildcard actions in KMS policies >>
            }
            when Action is_string {
                Action != "kms:*" << Avoid wildcard actions in KMS policies >>
            }
        }
    }
}

rule kms_key_administrative_permissions {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Action[*] == /kms:(Create|Delete|Put|Update).*/ {
                Principal.AWS == /arn:aws:iam::.*:role\/.*Admin.*/ or 
                Principal.AWS == /arn:aws:iam::.*:role\/.*KMS.*/ << Administrative actions should be limited to admin roles >>
            }
        }
    }
}

rule kms_key_encryption_permissions {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Action[*] == /kms:(Encrypt|Decrypt|GenerateDataKey)/ {
                Condition exists << Encryption operations should have conditions >>
                Principal.Service exists or Principal.AWS == /arn:aws:iam::.*:role\/.*/ << Encryption should be service or role-specific >>
            }
        }
    }
}

rule kms_key_grant_permissions {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Action[*] == /kms:(CreateGrant|RetireGrant)/ {
                Condition exists << Grant operations must have conditions >>
                Condition.StringEquals."kms:ViaService" exists << Grants should be service-specific >>
            }
        }
    }
}

# Service-Specific KMS Integration
rule kms_s3_integration_security {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Principal.Service == "s3.amazonaws.com" {
                Action[*] in ["kms:Decrypt", "kms:DescribeKey", "kms:Encrypt", "kms:GenerateDataKey", "kms:ReEncrypt*"] << S3 should only have necessary KMS actions >>
                Condition.StringEquals."kms:ViaService" == !Sub "s3.${AWS::Region}.amazonaws.com" << S3 access should be region-specific >>
            }
        }
    }
}

rule kms_logs_integration_security {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Principal.Service == "logs.amazonaws.com" {
                Action[*] in ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:DescribeKey"] << CloudWatch Logs should only have necessary KMS actions >>
                Condition.ArnEquals."kms:EncryptionContext:aws:logs:arn" exists << Logs should specify log group ARN >>
            }
        }
    }
}

rule kms_rds_integration_security {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Principal.Service == "rds.amazonaws.com" {
                Action[*] in ["kms:Decrypt", "kms:DescribeKey", "kms:Encrypt", "kms:GenerateDataKey", "kms:ReEncrypt*"] << RDS should only have necessary KMS actions >>
                Condition.StringEquals."kms:ViaService" == !Sub "rds.${AWS::Region}.amazonaws.com" << RDS access should be region-specific >>
            }
        }
    }
}

# Key Usage Context Validation
rule kms_encryption_context_validation {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Action[*] == /kms:(Encrypt|Decrypt)/ and Condition exists {
                Condition.StringEquals."kms:EncryptionContext:Environment" exists or
                Condition.StringEquals."kms:EncryptionContext:Project" exists << Encryption operations should use context for access control >>
            }
        }
    }
}

rule kms_key_via_service_restrictions {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Condition.StringEquals."kms:ViaService" exists {
                Condition.StringEquals."kms:ViaService" == /.*\.${AWS::Region}\.amazonaws\.com/ << ViaService should be region-specific >>
            }
        }
    }
}

# Production Environment Security
rule kms_production_key_security {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.KeyPolicy.Statement[*] {
                when Principal.AWS == !Sub "arn:aws:iam::${AWS::AccountId}:root" {
                    Condition exists << Root principal access in production must have conditions >>
                    Condition.StringEquals."aws:userid" exists << Root access should specify user ID >>
                }
            }
        }
    }
}

rule kms_production_administrative_controls {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.KeyPolicy.Statement[*] {
                when Action[*] == /kms:(ScheduleKeyDeletion|DisableKey)/ {
                    Principal.AWS == /arn:aws:iam::.*:role\/.*Admin.*/ << Key deletion in production should require admin role >>
                    Condition.StringEquals."aws:MultiFactorAuthPresent" == "true" << Destructive operations should require MFA >>
                }
            }
        }
    }
}

# Cross-Service Security
rule kms_prevent_cross_service_access {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Principal.Service exists and Action[*] == /kms:(Encrypt|Decrypt)/ {
                some Condition.StringEquals."kms:ViaService" exists << Service access should be restricted via ViaService condition >>
            }
        }
    }
}

rule kms_key_usage_logging {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        when Properties.Tags.*[Key == "Environment" && Value in ["staging", "production"]] exists {
            Properties.KeyPolicy.Statement[*] {
                when Action[*] == /kms:(Encrypt|Decrypt|GenerateDataKey)/ {
                    # Note: This would typically be enforced at the CloudTrail level
                    this exists << Key usage in staging/production should be logged via CloudTrail >>
                }
            }
        }
    }
}

# Key Alias Security
rule kms_alias_environment_isolation {
    Resources.*[ Type == "AWS::KMS::Alias" ] {
        Properties {
            AliasName == /alias\/.*-${Environment}$/ or AliasName == /alias\/${Environment}-.*/ << Alias should clearly indicate environment >>
        }
    }
}

rule kms_alias_purpose_indication {
    Resources.*[ Type == "AWS::KMS::Alias" ] {
        Properties {
            AliasName == /alias\/.*-(s3|rds|logs|ssm|ebs)-.*/ or 
            AliasName == /alias\/.*(app|data|config|secret).*/ << Alias should indicate purpose or service >>
        }
    }
}

# Development Environment Restrictions
rule kms_development_key_restrictions {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "dev"] exists {
            Properties.KeyPolicy.Statement[*] {
                when Action[*] == "kms:*" {
                    Principal.AWS != !Sub "arn:aws:iam::${AWS::AccountId}:root" << Development keys should not grant kms:* to root >>
                }
            }
        }
    }
}

# Key Policy Structure Validation
rule kms_key_policy_version {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy {
            Version == "2012-10-17" << KMS key policies should use current policy version >>
        }
    }
}

rule kms_key_policy_statement_structure {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            Effect exists << Policy statements must specify Effect >>
            Effect in ["Allow", "Deny"] << Effect must be Allow or Deny >>
            when Effect == "Deny" {
                Condition exists << Deny statements should have conditions to prevent lockout >>
            }
        }
    }
}