# Dedicated EC2 Security Rules

# Launch Template Security Best Practices
rule launch_template_user_data_no_secrets {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            when UserData exists {
                # This is a simplified check - in practice, you'd want more sophisticated secret detection
                UserData != /.*[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd].*/ << User data should not contain passwords >>
                UserData != /.*[Aa][Cc][Cc][Ee][Ss][Ss].*[Kk][Ee][Yy].*/ << User data should not contain access keys >>
            }
        }
    }
}

rule launch_template_monitoring_production {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        when Properties.LaunchTemplateData.TagSpecifications[*].Tags[*].Key == "Environment" and 
             Properties.LaunchTemplateData.TagSpecifications[*].Tags[*].Value == "production" {
            Properties.LaunchTemplateData {
                Monitoring exists << Production instances should have monitoring configured >>
                Monitoring.Enabled == true << Production instances should enable detailed monitoring >>
            }
        }
    }
}

rule launch_template_ebs_delete_on_termination {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData.BlockDeviceMappings[*] {
            when Ebs exists {
                Ebs.DeleteOnTermination exists << EBS delete on termination should be explicitly set >>
                Ebs.DeleteOnTermination == true << EBS volumes should be deleted with instance for cost savings >>
            }
        }
    }
}

rule launch_template_root_volume_encryption {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData.BlockDeviceMappings[*] {
            when DeviceName == "/dev/xvda" or DeviceName == "/dev/sda1" {
                Ebs {
                    Encrypted == true << Root volume must be encrypted >>
                }
            }
        }
    }
}

# EC2 Key Pair Security
rule launch_template_key_pair_environment_specific {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            when KeyName exists {
                KeyName != "" << Key pair name cannot be empty >>
                # Encourage environment-specific key pairs
                KeyName == /.*-(dev|staging|production).*/ << Key pair should be environment-specific for better security >>
            }
        }
    }
}

# IAM Security for EC2
rule iam_role_managed_policies_only {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties {
            ManagedPolicyArns exists << IAM Role should use managed policies >>
            ManagedPolicyArns not empty << Managed policies list should not be empty >>
            # Prefer managed policies over inline policies
            when Policies exists {
                Policies == [] << Prefer managed policies over inline policies for better security >>
            }
        }
    }
}

rule iam_role_ec2_container_service_policies {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.AssumeRolePolicyDocument.Statement[*].Principal.Service[*] == "ec2.amazonaws.com" {
            Properties.ManagedPolicyArns[*] {
                some == "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role" << ECS EC2 instances should have container service policy >>
            }
        }
    }
}