# Auto Scaling Group Security Rules
rule asg_has_health_check_grace_period {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties {
            HealthCheckGracePeriod exists
            HealthCheckGracePeriod >= 300 << Health check grace period should be at least 5 minutes for ECS instances >>
        }
    }
}

rule asg_has_proper_health_check_type {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties {
            HealthCheckType exists
            HealthCheckType in ["EC2", "ELB"] << Health check type must be EC2 or ELB >>
        }
    }
}

rule asg_has_capacity_rebalance_for_production {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties {
                CapacityRebalance exists
                CapacityRebalance == true << Production ASGs should enable capacity rebalancing >>
            }
        }
    }
}

rule asg_has_proper_termination_policies {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties {
            TerminationPolicies exists
            TerminationPolicies is_list
            TerminationPolicies not empty << Termination policies should be explicitly defined >>
        }
    }
}

rule asg_uses_launch_template_not_config {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties {
            LaunchTemplate exists << Use Launch Template instead of Launch Configuration >>
            LaunchConfigurationName not exists << Launch Configuration is deprecated >>
        }
    }
}

rule asg_launch_template_has_version {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties.LaunchTemplate {
            Version exists << Launch Template version should be specified >>
            Version != "" << Launch Template version cannot be empty >>
        }
    }
}

# ECS Cluster Security Rules
rule ecs_cluster_has_container_insights {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        Properties.ClusterSettings exists << ECS Cluster must have cluster settings configured >>
        Properties.ClusterSettings[*] {
            some Name == "containerInsights" << Container Insights must be configured >>
        }
    }
}

rule ecs_cluster_container_insights_enabled_for_monitoring {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        Properties.ClusterSettings.*[Name == "containerInsights"] {
            Value in ["enabled", "disabled"] << Container Insights value must be explicitly set >>
        }
    }
}

rule ecs_cluster_has_execute_command_logging {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        when Properties.Configuration exists {
            Properties.Configuration {
                ExecuteCommandConfiguration exists << Execute command logging should be configured for security >>
                ExecuteCommandConfiguration.Logging exists
                ExecuteCommandConfiguration.Logging != "NONE" << Execute command logging should not be disabled >>
            }
        }
    }
}

rule ecs_cluster_uses_proper_capacity_providers {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        Properties {
            CapacityProviders exists << ECS Cluster must specify capacity providers >>
            CapacityProviders is_list
            CapacityProviders not empty << Capacity providers list cannot be empty >>
        }
    }
}

rule ecs_cluster_has_default_capacity_strategy {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        Properties {
            DefaultCapacityProviderStrategy exists << ECS Cluster must have default capacity provider strategy >>
            DefaultCapacityProviderStrategy is_list
            DefaultCapacityProviderStrategy not empty << Default capacity provider strategy cannot be empty >>
        }
    }
}

# ECS Security Rules
rule ecs_task_definition_no_privileged_containers {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            Privileged not exists or Privileged == false << Containers should not run in privileged mode >>
        }
    }
}

rule ecs_containers_readonly_root_filesystem {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when Essential == true {
                ReadonlyRootFilesystem exists << Essential containers should specify readonly root filesystem >>
                ReadonlyRootFilesystem == true << Root filesystem should be readonly for security >>
            }
        }
    }
}

rule ecs_containers_no_root_user {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            User exists << Containers should specify non-root user >>
            User != "0" << Containers should not run as root user >>
            User != "root" << Containers should not run as root user >>
        }
    }
}

rule ecs_containers_environment_no_secrets {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when Environment exists {
                Environment[*] {
                    Name != /.*[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd].*/ << Environment variables should not contain password-like names >>
                    Name != /.*[Kk][Ee][Yy].*/ << Environment variables should not contain key-like names >>
                    Name != /.*[Ss][Ee][Cc][Rr][Ee][Tt].*/ << Environment variables should not contain secret-like names >>
                }
            }
        }
    }
}

rule ecs_service_no_public_ip {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties {
            when NetworkConfiguration exists {
                NetworkConfiguration.AwsvpcConfiguration {
                    AssignPublicIp not exists or AssignPublicIp == "DISABLED" << ECS Service should not assign public IP addresses >>
                }
            }
        }
    }
}

rule ecs_containers_use_secrets_manager {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when Secrets exists {
                Secrets[*] {
                    ValueFrom exists << Secrets must specify valueFrom >>
                    ValueFrom == /^arn:aws:secretsmanager:.*/ << Secrets should use AWS Secrets Manager >>
                }
            }
        }
    }
}

# Launch Template Security Rules
rule launch_template_requires_metadata_options {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            MetadataOptions exists << Launch Template must configure metadata options for security >>
            MetadataOptions.HttpTokens == "required" << IMDSv2 must be required for enhanced security >>
            MetadataOptions.HttpEndpoint == "enabled" << HTTP endpoint should be enabled for metadata access >>
        }
    }
}

rule launch_template_metadata_hop_limit {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData.MetadataOptions {
            HttpPutResponseHopLimit exists << Metadata hop limit should be configured >>
            HttpPutResponseHopLimit <= 2 << Metadata hop limit should be restrictive for containers >>
        }
    }
}

rule launch_template_ebs_encryption {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            BlockDeviceMappings exists << Launch Template should configure EBS encryption >>
            BlockDeviceMappings[*] {
                when Ebs exists {
                    Ebs.Encrypted == true << EBS volumes must be encrypted >>
                }
            }
        }
    }
}

rule launch_template_no_public_ip {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            AssociatePublicIpAddress not exists or 
            AssociatePublicIpAddress == false << Instances should not have public IP addresses >>
        }
    }
}

rule launch_template_has_iam_instance_profile {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            IamInstanceProfile exists << Launch Template must specify IAM instance profile >>
            IamInstanceProfile.Arn exists << IAM instance profile ARN must be specified >>
        }
    }
}

rule launch_template_security_groups_specified {
    Resources.*[ Type == "AWS::EC2::LaunchTemplate" ] {
        Properties.LaunchTemplateData {
            SecurityGroupIds exists << Launch Template must specify security groups >>
            SecurityGroupIds is_list
            SecurityGroupIds not empty << Security groups list cannot be empty >>
        }
    }
}

# IAM Role Security Rules
rule iam_role_has_trust_policy {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties {
            AssumeRolePolicyDocument exists << IAM Role must have assume role policy document >>
            AssumeRolePolicyDocument.Statement exists << Trust policy must have statements >>
            AssumeRolePolicyDocument.Statement not empty
        }
    }
}

rule iam_role_least_privilege_principals {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties.AssumeRolePolicyDocument.Statement[*] {
            Principal exists << IAM Role statements must specify principals >>
            Principal.Service exists << Service principals should be specified >>
        }
    }
}

rule iam_role_no_wildcard_actions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties {
            when Policies exists {
                Policies[*].PolicyDocument.Statement[*] {
                    Action != "*" << IAM policies should not allow all actions >>
                    Action[*] != "*" << IAM policy actions should not use wildcards >>
                }
            }
        }
    }
}

# CodeBuild Compute Security Rules
rule codebuild_container_security {
    Resources.*[ Type == "AWS::CodeBuild::Project" ] {
        Properties.Environment {
            when Type == "LINUX_CONTAINER" {
                Image exists << Linux containers must specify image >>
                # Prefer official AWS images
                Image == /aws\/codebuild\/.*/ << Use official AWS CodeBuild images >>
            }
        }
    }
}

rule codebuild_vpc_configuration {
    Resources.*[ Type == "AWS::CodeBuild::Project" ] {
        when Properties.VpcConfig exists {
            Properties.VpcConfig {
                VpcId exists << VPC configuration must specify VPC ID >>
                Subnets exists << VPC configuration must specify subnets >>
                Subnets not empty << Subnets list cannot be empty >>
                SecurityGroupIds exists << VPC configuration must specify security groups >>
            }
        }
    }
}

rule codebuild_compute_type_security {
    Resources.*[ Type == "AWS::CodeBuild::Project" ] {
        Properties.Environment {
            when ComputeType == "BUILD_GENERAL1_2XLARGE" {
                # Large compute types should be justified
                this exists << Large compute types should be justified for security workloads >>
            }
        }
    }
}

# CodeBuild IAM Security for Compute Resources
rule codebuild_role_container_permissions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodeBuild.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /ecr:.*/ {
                    # ECR permissions should be scoped to container builds
                    Action[*] != "ecr:DeleteRepository" << CodeBuild should not delete ECR repositories >>
                    Action[*] != "ecr:DeleteRepositoryPolicy" << CodeBuild should not delete repository policies >>
                }
            }
        }
    }
}

rule codebuild_role_compute_isolation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodeBuild.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /ec2:.*/ {
                    # If EC2 permissions exist, they should be limited
                    Action[*] in ["ec2:DescribeInstances", "ec2:DescribeImages"] << Limit EC2 permissions to read-only >>
                }
            }
        }
    }
}

# ECS Container Security Rules
rule ecs_task_execution_managed_policy_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.ManagedPolicyArns[*] {
                some this == "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy" << Task execution roles must include ECS managed policy >>
            }
        }
    }
}

rule ecs_container_registry_permissions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == "ecr:GetAuthorizationToken" {
                    Resource == "*" << ECR auth token requires global access >>
                }
                when Action[*] == /ecr:(BatchCheckLayerAvailability|GetDownloadUrlForLayer|BatchGetImage)/ {
                    Resource != "*" << ECR image operations should specify repository ARNs >>
                    Resource[*] == /arn:aws:ecr:.*:repository\/.*/ << ECR resources should be repository ARNs >>
                }
            }
        }
    }
}

rule ecs_log_group_permissions_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /logs:(CreateLogGroup|CreateLogStream|PutLogEvents)/ {
                    Resource[*] == /arn:aws:logs:.*:log-group:.*/ << Log actions should specify log group ARNs >>
                    Resource[*] != /.*:\*$/ << Log resources should not end with wildcard >>
                }
            }
        }
    }
}

rule ecs_secrets_manager_integration {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /secretsmanager:.*/ {
                    Action[*] in ["secretsmanager:GetSecretValue"] << Limit Secrets Manager actions to read-only >>
                    Resource != "*" << Secrets Manager resources should be specific secret ARNs >>
                }
            }
        }
    }
}

rule ecs_prevent_privileged_container_permissions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                Action[*] != "iam:*" << Task roles should not have IAM permissions >>
                Action[*] != "ec2:*" << Task roles should not have broad EC2 permissions >>
                Action[*] != "sts:AssumeRole" << Task roles should not assume other roles >>
            }
        }
    }
}