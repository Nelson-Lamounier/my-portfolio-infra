#
# Cost Optimization Rules
#

# Rule: ECS services should not over-provision resources
let ecs_services = Resources.*[ Type == 'AWS::ECS::Service' ]
rule ecs_resource_limits when %ecs_services !empty {
    %ecs_services.Properties.DesiredCount <= 5 <<Violation: ECS desired count should not exceed 5 for cost control>>
}

# Rule: Load balancers should use appropriate instance sizes
let task_definitions = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]
rule ecs_task_sizing when %task_definitions !empty {
    %task_definitions.Properties {
        when exists Cpu {
            Cpu <= 1024 <<Violation: ECS task CPU should not exceed 1024 for cost optimization>>
        }
        when exists Memory {
            Memory <= 2048 <<Violation: ECS task memory should not exceed 2GB for cost optimization>>
        }
    }
}