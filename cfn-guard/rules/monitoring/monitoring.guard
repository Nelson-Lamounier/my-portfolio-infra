# CloudWatch Monitoring Rules for Auto Scaling Groups

rule asg_has_detailed_monitoring {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties {
            EnabledMetrics exists
            EnabledMetrics not empty << Auto Scaling Group should have detailed monitoring enabled >>
        }
    }
}

rule asg_monitors_essential_metrics {
    Resources.*[ Type == "AWS::AutoScaling::AutoScalingGroup" ] {
        Properties.EnabledMetrics[*] {
            some == "GroupDesiredCapacity" << Should monitor desired capacity >>
            some == "GroupInServiceInstances" << Should monitor in-service instances >>
            some == "GroupMinSize" << Should monitor minimum size >>
            some == "GroupMaxSize" << Should monitor maximum size >>
        }
    }
}

rule cloudwatch_alarm_has_appropriate_period {
    Resources.*[ Type == "AWS::CloudWatch::Alarm" ] {
        Properties {
            Period exists
            Period >= 300 << CloudWatch alarm period should be at least 5 minutes >>
        }
    }
}

rule cloudwatch_alarm_has_evaluation_periods {
    Resources.*[ Type == "AWS::CloudWatch::Alarm" ] {
        Properties {
            EvaluationPeriods exists
            EvaluationPeriods >= 2 << CloudWatch alarms should evaluate multiple periods to avoid false positives >>
        }
    }
}

rule cloudwatch_alarm_treats_missing_data {
    Resources.*[ Type == "AWS::CloudWatch::Alarm" ] {
        Properties {
            TreatMissingData exists
            TreatMissingData in ["notBreaching", "breaching", "ignore"] << Missing data treatment should be explicitly defined >>
        }
    }
}

rule cpu_alarm_thresholds_environment_appropriate {
    Resources.*[ Type == "AWS::CloudWatch::Alarm" ] {
        when Properties.MetricName == "CPUUtilization" {
            when ../Tags.*[Key == "Environment" && Value == "production"] exists {
                Properties {
                    Threshold <= 80 << Production CPU high threshold should not exceed 80% >>
                }
            }
            when ../Tags.*[Key == "Environment" && Value in ["dev", "staging"]] exists {
                Properties {
                    Threshold <= 90 << Non-production CPU threshold can be higher but should not exceed 90% >>
                }
            }
        }
    }
}

# ECS Monitoring Rules
rule ecs_cluster_container_insights_production {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.ClusterSettings.*[Name == "containerInsights"] {
                Value == "enabled" << Production ECS clusters must have Container Insights enabled >>
            }
        }
    }
}

rule ecs_cluster_has_cloudwatch_log_retention {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        when Properties.Configuration.ExecuteCommandConfiguration.LogConfiguration exists {
            Properties.Configuration.ExecuteCommandConfiguration.LogConfiguration {
                CloudWatchLogGroupName exists << Execute command logs should use CloudWatch >>
            }
        }
    }
}

rule ecs_containers_have_logging {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            LogConfiguration exists << All containers must have logging configured >>
            LogConfiguration.LogDriver exists << Log driver must be specified >>
        }
    }
}

rule ecs_log_groups_environment_retention {
    Resources.*[ Type == "AWS::Logs::LogGroup" ] {
        when Properties.LogGroupName == /.*production.*/ {
            Properties {
                RetentionInDays >= 30 << Production log groups should retain logs for at least 30 days >>
            }
        }
        when Properties.LogGroupName == /.*dev.*/ {
            Properties {
                RetentionInDays >= 7 << Development log groups should retain logs for at least 7 days >>
            }
        }
    }
}

rule ecs_containers_awslogs_stream_prefix {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when LogConfiguration.LogDriver == "awslogs" {
                LogConfiguration.Options."awslogs-stream-prefix" exists << AWSlogs should have stream prefix >>
                LogConfiguration.Options."awslogs-stream-prefix" != "" << Stream prefix cannot be empty >>
            }
        }
    }
}

rule ecs_containers_log_group_creation {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when LogConfiguration.LogDriver == "awslogs" {
                LogConfiguration.Options."awslogs-create-group" exists << AWSlogs should specify create-group option >>
            }
        }
    }
}