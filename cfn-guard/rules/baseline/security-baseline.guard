#
# Security Baseline Rules for Portfolio Infrastructure
#

# Rule: All S3 buckets must have versioning enabled
let s3_buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]
rule s3_versioning when %s3_buckets !empty {
    %s3_buckets.Properties.VersioningConfiguration.Status == "Enabled"
    <<
        Violation: S3 bucket versioning must be enabled
        Fix: Add VersioningConfiguration.Status: "Enabled" to S3 bucket properties
    >>
}

# Rule: All security groups must not allow unrestricted access (0.0.0.0/0) on sensitive ports
let security_groups = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
rule restrict_sensitive_ports when %security_groups !empty {
    %security_groups.Properties.SecurityGroupIngress[*] {
        when CidrIp == "0.0.0.0/0" {
            FromPort != 22 <<Violation: SSH (22) should not be open to 0.0.0.0/0>>
            FromPort != 3389 <<Violation: RDP (3389) should not be open to 0.0.0.0/0>>
            FromPort != 1433 <<Violation: SQL Server (1433) should not be open to 0.0.0.0/0>>
            FromPort != 3306 <<Violation: MySQL (3306) should not be open to 0.0.0.0/0>>
            FromPort != 5432 <<Violation: PostgreSQL (5432) should not be open to 0.0.0.0/0>>
        }
    }
}

# Rule: Load balancers must have access logging enabled
let albs = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::LoadBalancer' ]
rule alb_access_logging when %albs !empty {
    %albs.Properties.LoadBalancerAttributes[*] {
        when Key == "access_logs.s3.enabled" {
            Value == "true" <<Violation: ALB access logging must be enabled>>
        }
    }
}

# Rule: ECS task definitions must not run as root
let task_definitions = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]
rule ecs_no_root_user when %task_definitions !empty {
    %task_definitions.Properties.ContainerDefinitions[*] {
        User != "root" or 
        User != "0" or 
        !exists User <<Violation: ECS containers should not run as root user>>
    }
}

# Rule: All IAM roles must have session duration limits
let iam_roles = Resources.*[ Type == 'AWS::IAM::Role' ]
rule iam_session_duration when %iam_roles !empty {
    %iam_roles.Properties {
        when exists MaxSessionDuration {
            MaxSessionDuration <= 43200 <<Violation: IAM role session duration should not exceed 12 hours>>
        }
    }
}

# Rule: CloudWatch log groups must have retention period set
let log_groups = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
rule log_retention when %log_groups !empty {
    %log_groups.Properties {
        exists RetentionInDays <<Violation: CloudWatch log groups must have retention period set>>
        RetentionInDays <= 90 <<Violation: Log retention should not exceed 90 days for cost optimization>>
    }
}

# VPC Security Baseline Rules
rule vpc_flow_logs_iam_role_secure {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.AssumeRolePolicyDocument.Statement[*].Principal.Service[*] == "vpc-flow-logs.amazonaws.com" {
            Properties {
                AssumeRolePolicyDocument.Statement[*] {
                    Effect == "Allow" << IAM role must allow assume role >>
                    Principal.Service == "vpc-flow-logs.amazonaws.com" << Principal must be VPC Flow Logs service >>
                }
            }
        }
    }
}

rule flow_logs_iam_least_privilege {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*FlowLog.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                Effect == "Allow" << Policy statements must explicitly allow actions >>
                Action exists << Actions must be specified >>
                Resource exists << Resources must be specified for least privilege >>
            }
        }
    }
}

rule vpc_endpoints_for_aws_services {
    # Encourage VPC endpoints for cost savings and security
    Resources.*[ Type == "AWS::EC2::VPCEndpoint" ] {
        Properties {
            ServiceName exists << VPC endpoint must specify service name >>
            VpcId exists << VPC endpoint must be associated with VPC >>
        }
    }
}

# Application Load Balancer Security Baseline
rule alb_production_deletion_protection {
    Resources.*[ Type == "AWS::ElasticLoadBalancingV2::LoadBalancer" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.LoadBalancerAttributes[*] {
                when Key == "deletion_protection.enabled" {
                    Value == "true" << Production load balancers must have deletion protection enabled >>
                }
            }
        }
    }
}

rule alb_production_access_logging {
    Resources.*[ Type == "AWS::ElasticLoadBalancingV2::LoadBalancer" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.LoadBalancerAttributes[*] {
                when Key == "access_logs.s3.enabled" {
                    Value == "true" << Production load balancers should have access logging enabled >>
                }
            }
        }
    }
}

rule alb_http_to_https_redirect {
    Resources.*[ Type == "AWS::ElasticLoadBalancingV2::Listener" ] {
        when Properties.Protocol == "HTTP" and Properties.Port == 80 {
            Properties.DefaultActions[*] {
                when Type == "redirect" {
                    RedirectConfig exists << HTTP redirects must have configuration >>
                    RedirectConfig.Protocol == "HTTPS" << HTTP should redirect to HTTPS >>
                    RedirectConfig.StatusCode == "HTTP_301" << Use permanent redirect for HTTPS >>
                }
            }
        }
    }
}

rule target_groups_secure_health_checks {
    Resources.*[ Type == "AWS::ElasticLoadBalancingV2::TargetGroup" ] {
        Properties {
            HealthCheckPath exists
            HealthCheckPath != "/" << Health check should use specific path, not root >>
            HealthCheckPath == /^\/health.*/ or 
            HealthCheckPath == /^\/status.*/ or 
            HealthCheckPath == /^\/ping.*/ << Health check should use dedicated health endpoint >>
        }
    }
}

rule listener_rules_have_conditions {
    Resources.*[ Type == "AWS::ElasticLoadBalancingV2::ListenerRule" ] {
        Properties {
            Conditions exists << Listener rules must have conditions >>
            Conditions not empty << Conditions list cannot be empty >>
            Actions exists << Listener rules must have actions >>
            Actions not empty << Actions list cannot be empty >>
        }
    }
}

# Route 53 DNS Security Baseline
rule route53_production_health_checks_required {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists or
             Properties.Comment == /.*production.*/i {
            # Production DNS should have corresponding health checks
            Properties exists << Production DNS records should have health monitoring >>
        }
    }
}

rule route53_no_hardcoded_ips {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Type == "A" {
            Properties {
                AliasTarget exists or ResourceRecords not exists << A records should use alias targets instead of hardcoded IPs >>
                when ResourceRecords exists {
                    ResourceRecords[*] != /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ << Avoid hardcoded IP addresses in DNS records >>
                }
            }
        }
    }
}

rule route53_health_check_failure_threshold {
    Resources.*[ Type == "AWS::Route53::HealthCheck" ] {
        Properties {
            FailureThreshold exists << Health checks must specify failure threshold >>
            FailureThreshold >= 3 << Failure threshold should be at least 3 to avoid false positives >>
            FailureThreshold <= 10 << Failure threshold should not exceed 10 >>
        }
    }
}

rule route53_alias_target_validation {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.AliasTarget exists {
            Properties.AliasTarget {
                DNSName != "" << Alias target DNS name cannot be empty >>
                HostedZoneId != "" << Alias target hosted zone ID cannot be empty >>
                # Ensure targeting AWS resources, not external
                DNSName == /.*\.amazonaws\.com$/ or 
                DNSName == /.*\.elb\..*\.amazonaws\.com$/ or
                DNSName == /.*\.cloudfront\.net$/ << Alias targets should point to AWS resources >>
            }
        }
    }
}

rule route53_ipv6_security_consideration {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Type == "AAAA" {
            Properties {
                AliasTarget exists << IPv6 records should use alias targets for AWS resources >>
                Comment exists << IPv6 records should have comments explaining their purpose >>
            }
        }
    }
}

# AWS Certificate Manager (ACM) Security Baseline
rule acm_certificate_dns_validation {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            ValidationMethod exists << SSL certificates must specify validation method >>
            ValidationMethod == "DNS" << Use DNS validation for automated and secure certificate validation >>
        }
    }
}

rule acm_certificate_transparency_logging {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            CertificateTransparencyLoggingPreference exists << Certificate transparency logging preference must be specified >>
            CertificateTransparencyLoggingPreference == "ENABLED" << Certificate transparency logging should be enabled for security >>
        }
    }
}

rule acm_domain_validation_options_required {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        when Properties.ValidationMethod == "DNS" {
            Properties {
                DomainValidationOptions exists << DNS validation requires domain validation options >>
                DomainValidationOptions not empty << Domain validation options cannot be empty >>
            }
        }
    }
}

rule acm_hosted_zone_validation {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        when Properties.DomainValidationOptions exists {
            Properties.DomainValidationOptions[*] {
                HostedZoneId exists << Domain validation must specify hosted zone ID >>
                HostedZoneId != "" << Hosted zone ID cannot be empty >>
                DomainName exists << Domain validation must specify domain name >>
                DomainName != "" << Domain name cannot be empty >>
            }
        }
    }
}

rule acm_no_wildcard_certificates_in_dev {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "dev"] exists {
            Properties {
                DomainName != /^\*\..*/ << Avoid wildcard certificates in development for security >>
                when SubjectAlternativeNames exists {
                    SubjectAlternativeNames[*] != /^\*\..*/ << Avoid wildcard SANs in development >>
                }
            }
        }
    }
}

# CI/CD Pipeline Security Baseline
rule codebuild_privileged_mode_justification {
    Resources.*[ Type == "AWS::CodeBuild::Project" ] {
        Properties.Environment {
            when PrivilegedMode == true {
                # Privileged mode should only be used for Docker builds
                Image == /.*docker.*/ or Image == /.*container.*/ << Privileged mode should only be used for container builds >>
            }
        }
    }
}

rule codepipeline_artifact_encryption {
    Resources.*[ Type == "AWS::CodePipeline::Pipeline" ] {
        Properties.ArtifactStore {
            EncryptionKey exists << Pipeline artifacts must be encrypted >>
            EncryptionKey.Type == "KMS" << Use KMS encryption for pipeline artifacts >>
            EncryptionKey.Id exists << KMS key ID must be specified >>
        }
    }
}

rule codebuild_service_role_validation {
    Resources.*[ Type == "AWS::CodeBuild::Project" ] {
        Properties {
            ServiceRole exists << CodeBuild projects must specify service role >>
            ServiceRole != "" << Service role cannot be empty >>
            ServiceRole == /arn:aws:iam:.*/ << Service role must be valid IAM role ARN >>
        }
    }
}

rule codepipeline_service_role_validation {
    Resources.*[ Type == "AWS::CodePipeline::Pipeline" ] {
        Properties {
            RoleArn exists << CodePipeline must specify service role >>
            RoleArn != "" << Role ARN cannot be empty >>
            RoleArn == /arn:aws:iam:.*/ << Role ARN must be valid IAM role ARN >>
        }
    }
}

rule codepipeline_production_approval_required {
    Resources.*[ Type == "AWS::CodePipeline::Pipeline" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.Stages[*] {
                some Name == "Approval" << Production pipelines must include approval stage >>
            }
        }
    }
}

rule codebuild_environment_variables_no_secrets {
    Resources.*[ Type == "AWS::CodeBuild::Project" ] {
        Properties.Environment.EnvironmentVariables[*] {
            Name != /.*[Pp]assword.*/ << Environment variable names should not contain 'password' >>
            Name != /.*[Ss]ecret.*/ << Environment variable names should not contain 'secret' >>
            Name != /.*[Kk]ey.*/ << Environment variable names should not contain 'key' >>
        }
    }
}

# IAM Role Security Baseline for CI/CD
rule iam_role_trust_policy_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties.AssumeRolePolicyDocument {
            Version == "2012-10-17" << IAM policies must use current version >>
            Statement[*] {
                Effect == "Allow" << Trust policy statements should be explicit >>
                Principal.Service exists << Service principals must be specified >>
                Action == "sts:AssumeRole" << Use specific AssumeRole action >>
            }
        }
    }
}

rule iam_role_service_principal_restriction {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodeBuild.*/ {
            Properties.AssumeRolePolicyDocument.Statement[*] {
                Principal.Service == "codebuild.amazonaws.com" << CodeBuild roles should only trust CodeBuild service >>
                when Condition exists {
                    Condition.StringEquals exists << Use conditions to restrict assume role >>
                }
            }
        }
    }
}

rule iam_role_path_environment_isolation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties {
            Path exists << IAM roles should use paths for organization >>
            Path == /^\/.*\/$/ << Role path should start and end with forward slash >>
            Path == /.*${Environment}.*/ << Role path should include environment for isolation >>
        }
    }
}

rule iam_policy_no_wildcard_resources {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        Properties.Policies[*].PolicyDocument.Statement[*] {
            when Effect == "Allow" {
                when Resource exists {
                    Resource != "*" << Avoid wildcard resources in IAM policies >>
                    when Resource is_list {
                        Resource[*] != "*" << Avoid wildcard resources in resource lists >>
                    }
                }
            }
        }
    }
}

rule iam_managed_policy_restrictions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.ManagedPolicyArns exists {
            Properties.ManagedPolicyArns[*] {
                this != "arn:aws:iam::aws:policy/PowerUserAccess" << Avoid overly broad managed policies >>
                this != "arn:aws:iam::aws:policy/IAMFullAccess" << Avoid IAM full access policies >>
                this != "arn:aws:iam::aws:policy/AdministratorAccess" << Avoid administrator access >>
            }
        }
    }
}

# CodePipeline IAM Security Baseline
rule codepipeline_role_trust_policy_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodePipeline.*/ {
            Properties.AssumeRolePolicyDocument {
                Version == "2012-10-17" << CodePipeline IAM policies must use current version >>
                Statement[*] {
                    Effect == "Allow" << Trust policy statements should be explicit >>
                    Principal.Service == "codepipeline.amazonaws.com" << CodePipeline roles should only trust CodePipeline service >>
                    Action == "sts:AssumeRole" << Use specific AssumeRole action >>
                    when Condition exists {
                        Condition.StringEquals exists << Use conditions to restrict assume role >>
                        Condition.StringEquals."aws:RequestedRegion" exists << Restrict to specific regions >>
                    }
                }
            }
        }
    }
}

rule codepipeline_s3_artifact_encryption {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodePipeline.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /s3:.*/ {
                    # S3 access should be paired with KMS permissions when using encryption
                    Resource exists << S3 actions must specify specific bucket resources >>
                    Resource != "*" << S3 resources should not use wildcards >>
                }
            }
        }
    }
}

rule codepipeline_iam_passrole_restrictions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodePipeline.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == "iam:PassRole" {
                    Resource exists << PassRole action must specify specific role ARNs >>
                    Resource != "*" << PassRole should not use wildcard resources >>
                    when Resource is_list {
                        Resource[*] == /arn:aws:iam::.*:role\/.*/ << PassRole resources must be valid role ARNs >>
                    }
                }
            }
        }
    }
}

rule codepipeline_codestar_connection_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodePipeline.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /codestar-connections:.*/ {
                    Resource exists << CodeStar connection actions must specify connection ARNs >>
                    Resource != "*" << CodeStar connections should not use wildcards >>
                }
            }
        }
    }
}

rule codepipeline_environment_isolation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*CodePipeline.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Resource is_list {
                    Resource[*] {
                        when this == /.*-(dev|staging|production).*/ {
                            this == /.*${Environment}.*/ << CodePipeline should only access same environment resources >>
                        }
                    }
                }
            }
        }
    }
}

# ECS IAM Security Baseline
rule ecs_task_execution_role_trust_policy {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.AssumeRolePolicyDocument {
                Version == "2012-10-17" << ECS task execution roles must use current policy version >>
                Statement[*] {
                    Effect == "Allow" << Trust policy statements should be explicit >>
                    Principal.Service == "ecs-tasks.amazonaws.com" << Task execution roles should only trust ECS tasks service >>
                    Action == "sts:AssumeRole" << Use specific AssumeRole action >>
                }
            }
        }
    }
}

rule ecs_task_role_trust_policy {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskRole.*/ {
            Properties.AssumeRolePolicyDocument {
                Version == "2012-10-17" << ECS task roles must use current policy version >>
                Statement[*] {
                    Effect == "Allow" << Trust policy statements should be explicit >>
                    Principal.Service == "ecs-tasks.amazonaws.com" << Task roles should only trust ECS tasks service >>
                    Action == "sts:AssumeRole" << Use specific AssumeRole action >>
                }
            }
        }
    }
}

rule ecs_service_role_trust_policy {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ServiceRole.*/ {
            Properties.AssumeRolePolicyDocument {
                Version == "2012-10-17" << ECS service roles must use current policy version >>
                Statement[*] {
                    Effect == "Allow" << Trust policy statements should be explicit >>
                    Principal.Service == "ecs.amazonaws.com" << Service roles should only trust ECS service >>
                    Action == "sts:AssumeRole" << Use specific AssumeRole action >>
                }
            }
        }
    }
}

rule ecs_role_environment_isolation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties {
                Path exists << ECS roles should use paths for organization >>
                Path == /^\/.*\/$/ << Role path should start and end with forward slash >>
                Path == /.*${Environment}.*/ << Role path should include environment for isolation >>
            }
        }
    }
}

rule ecs_ecr_repository_access_control {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /ecr:.*/ and Resource != "*" {
                    Resource == /.*-${Environment}.*/ or Resource == /.*\/${Environment}-.*/ << ECR repository access should be environment-specific >>
                }
            }
        }
    }
}

rule ecs_cloudwatch_logs_scoping {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /logs:.*/ {
                    Resource exists << CloudWatch Logs actions must specify resources >>
                    Resource != "*" << CloudWatch Logs resources should not use wildcards >>
                    Resource[*] == /.*\/${Environment}\/.*/ or Resource[*] == /.*${Environment}.*/ << Log resources should be environment-specific >>
                }
            }
        }
    }
}

# Security Group Security Baseline
rule security_group_vpc_association {
    Resources.*[ Type == "AWS::EC2::SecurityGroup" ] {
        Properties {
            VpcId exists << Security groups must be associated with a VPC >>
            VpcId != "" << VPC ID cannot be empty >>
        }
    }
}

rule security_group_ingress_rule_descriptions {
    Resources.*[ Type == "AWS::EC2::SecurityGroup" ] {
        Properties.SecurityGroupIngress[*] {
            Description exists << All ingress rules must have descriptions >>
            Description != "" << Ingress rule descriptions cannot be empty >>
            Description != "Allow all traffic" << Descriptions should be specific, not generic >>
        }
    }
}

rule security_group_egress_rule_descriptions {
    Resources.*[ Type == "AWS::EC2::SecurityGroup" ] {
        Properties.SecurityGroupEgress[*] {
            Description exists << All egress rules must have descriptions >>
            Description != "" << Egress rule descriptions cannot be empty >>
        }
    }
}

rule security_group_port_range_validation {
    Resources.*[ Type == "AWS::EC2::SecurityGroup" ] {
        Properties.SecurityGroupIngress[*] {
            when FromPort exists and ToPort exists {
                FromPort <= ToPort << FromPort must be less than or equal to ToPort >>
                FromPort >= 0 << FromPort must be non-negative >>
                ToPort <= 65535 << ToPort must be valid port number >>
            }
        }
    }
}

rule security_group_ephemeral_port_restrictions {
    Resources.*[ Type == "AWS::EC2::SecurityGroup" ] {
        Properties.SecurityGroupIngress[*] {
            when FromPort >= 32768 and ToPort >= 49152 {
                ToPort - FromPort <= 16384 << Ephemeral port ranges should be limited for security >>
                SourceSecurityGroupId exists << Large port ranges should use security group references >>
            }
        }
    }
}

rule security_group_protocol_validation {
    Resources.*[ Type == "AWS::EC2::SecurityGroup" ] {
        Properties.SecurityGroupIngress[*] {
            IpProtocol exists << Security group rules must specify protocol >>
            IpProtocol in ["tcp", "udp", "icmp", "icmpv6", "-1"] << Use valid IP protocols >>
            when IpProtocol == "-1" {
                CidrIp != "0.0.0.0/0" << All protocols rule should not allow unrestricted access >>
            }
        }
    }
}

# KMS Security Baseline Rules
rule kms_key_rotation_enabled {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties {
            EnableKeyRotation == true << KMS keys must have automatic rotation enabled >>
        }
    }
}

rule kms_key_policy_not_overly_permissive {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            when Action == "kms:*" {
                Principal.AWS != !Sub "arn:aws:iam::${AWS::AccountId}:root" << Avoid granting kms:* to root principal >>
                Resource != "*" << Avoid wildcard resources with kms:* permissions >>
            }
        }
    }
}

rule kms_key_policy_principal_validation {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties.KeyPolicy.Statement[*] {
            Principal exists << KMS key policy statements must specify principals >>
            when Principal.AWS exists {
                Principal.AWS != "*" << KMS key policies should not allow access from any AWS account >>
            }
        }
    }
}

rule kms_key_description_required {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties {
            Description exists << KMS keys must have descriptions >>
            Description != "" << KMS key description cannot be empty >>
            Description == /.*${Environment}.*/ << Description should include environment >>
        }
    }
}

rule kms_key_deletion_protection {
    Resources.*[ Type == "AWS::KMS::Key" ] {
        Properties {
            when PendingWindowInDays exists {
                PendingWindowInDays >= 7 << KMS key deletion window should be at least 7 days >>
                PendingWindowInDays <= 30 << KMS key deletion window should not exceed 30 days >>
            }
        }
    }
}

rule kms_alias_naming_convention {
    Resources.*[ Type == "AWS::KMS::Alias" ] {
        Properties {
            AliasName exists << KMS aliases must have names >>
            AliasName == /^alias\/.*/ << KMS alias names must start with 'alias/' >>
            AliasName == /.*${Environment}.*/ << KMS alias should include environment >>
            AliasName != "alias/aws/*" << Do not use AWS reserved alias names >>
        }
    }
}

rule kms_alias_target_validation {
    Resources.*[ Type == "AWS::KMS::Alias" ] {
        Properties {
            TargetKeyId exists << KMS aliases must specify target key >>
            TargetKeyId != "" << Target key ID cannot be empty >>
        }
    }
}