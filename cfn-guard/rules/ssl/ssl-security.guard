# Dedicated SSL Certificate Security Rules

# Advanced SSL Certificate Security Configuration
rule acm_certificate_lifecycle_management {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            ValidationMethod == "DNS" << DNS validation enables automatic renewal >>
            Tags.*[Key == "Name"] {
                Value != "" << Certificate name tag cannot be empty >>
            }
        }
    }
}

rule acm_domain_ownership_validation {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties.DomainValidationOptions[*] {
            DomainName exists << Each domain validation must specify domain name >>
            HostedZoneId exists << Each domain must reference owned hosted zone >>
            # Ensure domain matches what's in the certificate
            DomainName != /^\s*$/ << Domain name cannot be whitespace only >>
        }
    }
}

rule acm_certificate_scope_validation {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            DomainName != /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ << Certificates should not be issued for IP addresses >>
            when SubjectAlternativeNames exists {
                SubjectAlternativeNames[*] {
                    this != /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ << SANs should not include IP addresses >>
                }
            }
        }
    }
}

rule acm_wildcard_certificate_restrictions {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        when Properties.DomainName == /^\*\..*/ {
            Properties {
                # Wildcard certificates should have specific security considerations
                Tags.*[Key == "Purpose"] {
                    Value exists << Wildcard certificates must have clear purpose documentation >>
                }
                # Limit wildcard depth
                DomainName == /^\*\.[a-zA-Z0-9\-]+\.[a-zA-Z]{2,}$/ << Wildcard should be single-level (*.example.com) >>
            }
        }
    }
}

rule acm_certificate_domain_consistency {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            when SubjectAlternativeNames exists {
                # All domains should be related (same base domain or subdomain)
                DomainName exists << Primary domain must exist when SANs are specified >>
            }
        }
    }
}

rule acm_production_certificate_requirements {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties {
                CertificateTransparencyLoggingPreference == "ENABLED" << Production certificates must have transparency logging >>
                DomainValidationOptions exists << Production certificates must have domain validation >>
                DomainValidationOptions not empty << Production domain validation cannot be empty >>
            }
        }
    }
}

rule acm_certificate_validation_timeout {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            ValidationMethod == "DNS" << DNS validation is more reliable than email >>
            when DomainValidationOptions exists {
                DomainValidationOptions[*] {
                    HostedZoneId == /^Z[A-Z0-9]{10,32}$/ << Hosted zone ID should be valid AWS format >>
                }
            }
        }
    }
}

rule acm_certificate_export_naming_security {
    Outputs.*[Export.Name == /.*Certificate.*/ or Export.Name == /.*SSL.*/] {
        Export.Name != /.*[Pp]rivate.*/ << Certificate exports should not include 'private' in name >>
        Export.Name != /.*[Kk]ey.*/ << Certificate exports should not include 'key' in name >>
        Export.Name == /.*Arn.*/ or Export.Name == /.*Domain.*/ << Certificate exports should be descriptive >>
    }
}

# Cross-Region Certificate Considerations
rule acm_certificate_region_awareness {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            Tags.*[Key == "Purpose"] {
                when Value == /.*[Cc]loud[Ff]ront.*/ {
                    # CloudFront certificates must be in us-east-1
                    this exists << CloudFront certificates have region requirements >>
                }
            }
        }
    }
}

# Certificate Security Best Practices
rule acm_avoid_overly_broad_certificates {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties {
            when SubjectAlternativeNames exists {
                length(SubjectAlternativeNames) <= 25 << Limit number of SANs for security and management >>
            }
        }
    }
}

rule acm_certificate_tags_security_metadata {
    Resources.*[ Type == "AWS::CertificateManager::Certificate" ] {
        Properties.Tags[*] {
            when Key == "Purpose" {
                Value != /.*[Pp]assword.*/ << Purpose should not contain sensitive terms >>
                Value != /.*[Ss]ecret.*/ << Purpose should not contain sensitive terms >>
                Value != /.*[Kk]ey.*/ << Purpose should not contain sensitive terms >>
            }
        }
    }
}