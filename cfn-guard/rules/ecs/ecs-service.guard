# Dedicated ECS Rules for Services and Clusters

# ECS Cluster Configuration Rules
rule ecs_cluster_configuration_best_practices {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        Properties {
            # Ensure cluster has proper configuration block
            Configuration exists << ECS Cluster should have configuration block for advanced features >>
        }
    }
}

rule ecs_cluster_execute_command_config_secure {
    Resources.*[ Type == "AWS::ECS::Cluster" ] {
        when Properties.Configuration.ExecuteCommandConfiguration exists {
            Properties.Configuration.ExecuteCommandConfiguration {
                KmsKeyId exists << Execute command should use KMS encryption >>
                LogConfiguration exists << Execute command should have log configuration >>
                LogConfiguration.CloudWatchLogGroupName exists << CloudWatch log group should be specified >>
            }
        }
    }
}

# ECS Service Configuration Rules
rule ecs_service_has_deployment_configuration {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties {
            DeploymentConfiguration exists << ECS Service must have deployment configuration >>
            DeploymentConfiguration.MaximumPercent exists << Maximum percent must be specified >>
            DeploymentConfiguration.MinimumHealthyPercent exists << Minimum healthy percent must be specified >>
        }
    }
}

rule ecs_service_has_health_check_grace_period {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties {
            HealthCheckGracePeriodSeconds exists << ECS Service must have health check grace period >>
            HealthCheckGracePeriodSeconds >= 60 << Health check grace period should be at least 60 seconds >>
            HealthCheckGracePeriodSeconds <= 600 << Health check grace period should not exceed 10 minutes >>
        }
    }
}

rule ecs_service_uses_load_balancer {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties {
            LoadBalancers exists << ECS Service should use load balancer for high availability >>
            LoadBalancers is_list
            LoadBalancers not empty << Load balancers list cannot be empty >>
        }
    }
}

rule ecs_service_has_circuit_breaker {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties.DeploymentConfiguration {
            DeploymentCircuitBreaker exists << ECS Service should have deployment circuit breaker >>
            DeploymentCircuitBreaker.Enable == true << Deployment circuit breaker should be enabled >>
        }
    }
}

rule ecs_service_circuit_breaker_rollback_production {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        when Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.DeploymentConfiguration.DeploymentCircuitBreaker {
                Rollback == true << Production services should have circuit breaker rollback enabled >>
            }
        }
    }
}

rule ecs_service_has_managed_tags {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties {
            EnableECSManagedTags exists << ECS Service should enable managed tags >>
            EnableECSManagedTags == true << ECS managed tags should be enabled for better resource tracking >>
        }
    }
}

rule ecs_service_proper_deployment_percentages {
    Resources.*[ Type == "AWS::ECS::Service" ] {
        Properties.DeploymentConfiguration {
            MaximumPercent >= 100 << Maximum percent should be at least 100% >>
            MaximumPercent <= 200 << Maximum percent should not exceed 200% >>
            MinimumHealthyPercent >= 0 << Minimum healthy percent cannot be negative >>
            MinimumHealthyPercent <= 100 << Minimum healthy percent cannot exceed 100% >>
        }
    }
}

# ECS Task Definition Rules
rule ecs_task_definition_has_execution_role {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties {
            ExecutionRoleArn exists << ECS Task Definition must have execution role >>
            ExecutionRoleArn != "" << Execution role ARN cannot be empty >>
        }
    }
}

rule ecs_task_definition_has_task_role {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties {
            TaskRoleArn exists << ECS Task Definition should have task role for application permissions >>
            TaskRoleArn != "" << Task role ARN cannot be empty >>
        }
    }
}

rule ecs_task_definition_has_family {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties {
            Family exists << ECS Task Definition must have family name >>
            Family != "" << Family name cannot be empty >>
        }
    }
}

rule ecs_task_definition_network_mode_appropriate {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties {
            NetworkMode exists << Network mode must be specified >>
            NetworkMode in ["bridge", "host", "awsvpc", "none"] << Network mode must be valid >>
        }
    }
}

# Container Definition Rules
rule ecs_containers_use_awslogs {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            LogConfiguration exists << All containers must have log configuration >>
            LogConfiguration.LogDriver == "awslogs" << Containers should use awslogs driver >>
            LogConfiguration.Options."awslogs-group" exists << CloudWatch log group must be specified >>
            LogConfiguration.Options."awslogs-region" exists << AWS region must be specified for logs >>
        }
    }
}

rule ecs_containers_have_resource_limits {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when Essential == true {
                MemoryReservation exists or Memory exists << Essential containers must have memory limits >>
                Cpu exists << Essential containers should have CPU limits >>
            }
        }
    }
}

rule ecs_containers_essential_marked {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            Essential exists << Container essentiality must be explicitly defined >>
        }
    }
}

rule ecs_containers_port_mappings_valid {
    Resources.*[ Type == "AWS::ECS::TaskDefinition" ] {
        Properties.ContainerDefinitions[*] {
            when PortMappings exists {
                PortMappings[*] {
                    ContainerPort exists << Container port must be specified >>
                    ContainerPort >= 1 << Container port must be valid >>
                    ContainerPort <= 65535 << Container port must be within valid range >>
                    Protocol exists << Protocol must be specified >>
                    Protocol in ["tcp", "udp"] << Protocol must be tcp or udp >>
                }
            }
        }
    }
}