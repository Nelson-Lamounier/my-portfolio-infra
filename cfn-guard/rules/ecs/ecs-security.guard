# Dedicated ECS Security Rules

# ECS Task Execution Role Security
rule ecs_task_execution_ssm_parameter_security {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /ssm:Get.*/ {
                    Resource[*] == /.*parameter\/.*/ << SSM resources should be parameter ARNs >>
                    Resource[*] != /.*parameter\/global\/\*$/ << Avoid broad global parameter access >>
                    # Environment-specific parameter access
                    some Resource[*] == /.*parameter\/${Environment}\/.*/ << Should access environment-specific parameters >>
                }
            }
        }
    }
}

rule ecs_task_execution_kms_integration {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /kms:.*/ {
                    Action[*] in ["kms:Decrypt", "kms:DescribeKey", "kms:GenerateDataKey"] << Limit KMS actions to necessary operations >>
                    Resource != "*" << KMS resources should not use wildcards >>
                    Resource == /arn:aws:kms:.*/ << KMS resources should be specific key ARNs >>
                }
            }
        }
    }
}

rule ecs_task_execution_log_isolation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /logs:.*/ {
                    Resource[*] == /.*\/ecs\/${Environment}\/.*/ or 
                    Resource[*] == /.*\/aws\/ecs\/${Environment}\/.*/ or
                    Resource[*] == /.*\/aws\/ecs\/containerinsights\/${Environment}.*/ << Log access should be ECS and environment-specific >>
                }
            }
        }
    }
}

# ECS Task Role Security
rule ecs_task_role_application_permissions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /ssm:.*/ {
                    Resource[*] == /.*parameter\/${Environment}\/app\/.*/ << Task roles should only access application parameters >>
                    Action[*] in ["ssm:GetParameter", "ssm:GetParameters"] << Limit SSM actions to read-only >>
                }
            }
        }
    }
}

rule ecs_task_role_s3_bucket_isolation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /s3:.*/ {
                    Resource[*] == /.*${ProjectName}-${Environment}-.*/ << S3 access should be project and environment-specific >>
                    Action[*] in ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"] << Limit S3 actions to object operations >>
                }
            }
        }
    }
}

rule ecs_task_role_prevent_escalation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                Action[*] != "sts:AssumeRole" << Task roles should not assume other roles >>
                Action[*] != /iam:.*/ << Task roles should not have IAM permissions >>
                Action[*] != /lambda:.*/ << Task roles should not invoke Lambda functions >>
                Action[*] != /ecs:.*/ << Task roles should not manage ECS resources >>
            }
        }
    }
}

# ECS Service Role Security
rule ecs_service_role_alb_permissions {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ServiceRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /elasticloadbalancing:.*/ {
                    Action[*] in ["elasticloadbalancing:DeregisterInstancesFromLoadBalancer",
                                 "elasticloadbalancing:DeregisterTargets",
                                 "elasticloadbalancing:Describe*",
                                 "elasticloadbalancing:RegisterInstancesWithLoadBalancer",
                                 "elasticloadbalancing:RegisterTargets"] << Limit ALB actions to necessary operations >>
                    Resource[*] == /.*${ProjectName}-${Environment}.*/ << ALB resources should be project and environment-specific >>
                }
            }
        }
    }
}

rule ecs_service_role_managed_policy_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ServiceRole.*/ {
            Properties.ManagedPolicyArns[*] {
                some this == "arn:aws:iam::aws:policy/service-role/AmazonECSServiceRolePolicy" << Service roles must include ECS service managed policy >>
                this != "arn:aws:iam::aws:policy/PowerUserAccess" << Avoid overly broad managed policies >>
                this != "arn:aws:iam::aws:policy/IAMFullAccess" << Avoid IAM full access policies >>
            }
        }
    }
}

# Production-Specific Security Requirements
rule ecs_production_monitoring_requirements {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ and Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == "cloudwatch:PutMetricData" {
                    Resource != "*" << Production CloudWatch metrics should specify resource ARNs >>
                }
                when Action[*] == /xray:.*/ {
                    Action[*] in ["xray:PutTraceSegments", "xray:PutTelemetryRecords"] << Limit X-Ray actions to necessary operations >>
                }
            }
        }
    }
}

rule ecs_production_cross_account_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ and Properties.Tags.*[Key == "Environment" && Value == "production"] exists {
            Properties.AssumeRolePolicyDocument.Statement[*] {
                when Principal.AWS exists {
                    Principal.AWS == /arn:aws:iam::${AWS::AccountId}:root/ << Cross-account access should be same account only >>
                    Condition exists << Cross-account access must have conditions >>
                    Condition.StringEquals."sts:ExternalId" exists << External ID required for cross-account access >>
                }
            }
        }
    }
}

# Environment Isolation Security
rule ecs_prevent_cross_environment_ecr_access {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Resource[*] == /arn:aws:ecr:.*:repository\/.*/ {
                    Resource[*] {
                        when this == /.*-(dev|staging|production).*/ {
                            this == /.*-${Environment}.*/ or this == /.*${Environment}-.*/ << ECR repositories should match role environment >>
                        }
                    }
                }
            }
        }
    }
}

rule ecs_prevent_cross_environment_log_access {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Resource[*] == /arn:aws:logs:.*:log-group:.*/ {
                    Resource[*] {
                        when this == /.*\/(dev|staging|production)\/.*/ {
                            this == /.*\/${Environment}\/.*/ << Log groups should match role environment >>
                        }
                    }
                }
            }
        }
    }
}

# Development Environment Restrictions
rule ecs_development_permission_limits {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ and Properties.Tags.*[Key == "Environment" && Value == "dev"] exists {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == "*" {
                    # No wildcard actions in any environment
                    Action[*] != "*" << Wildcard actions not allowed even in development >>
                }
                when Resource == "*" and Action[*] != "ecr:GetAuthorizationToken" {
                    # Limit wildcard resources
                    Resource != "*" << Limit wildcard resources in development >>
                }
            }
        }
    }
}

# Container Security Best Practices
rule ecs_container_secrets_access {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*TaskExecutionRole.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /secretsmanager:.*/ {
                    Resource[*] == /.*${Environment}.*/ << Secrets should be environment-specific >>
                    Action[*] == "secretsmanager:GetSecretValue" << Limit to read-only secrets access >>
                }
            }
        }
    }
}

rule ecs_network_isolation_validation {
    Resources.*[ Type == "AWS::IAM::Role" ] {
        when Properties.RoleName == /.*ECS.*/ {
            Properties.Policies[*].PolicyDocument.Statement[*] {
                when Action[*] == /ec2:.*/ {
                    # If EC2 permissions exist, they should be limited
                    Action[*] in ["ec2:DescribeNetworkInterfaces", "ec2:CreateNetworkInterface", "ec2:DeleteNetworkInterface"] << Limit EC2 permissions to network interface management >>
                }
            }
        }
    }
}