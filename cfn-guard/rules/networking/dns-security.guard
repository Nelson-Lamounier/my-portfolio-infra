# Dedicated DNS Security Rules

# Advanced Route 53 Security Configuration
rule route53_record_type_validation {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        Properties {
            Type exists << DNS record type must be specified >>
            Type in ["A", "AAAA", "CNAME", "MX", "TXT", "SRV", "PTR", "NS", "SOA"] << Use valid DNS record types >>
        }
    }
}

rule route53_weight_routing_security {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Weight exists {
            Properties {
                Weight > 0 << Weight routing should have positive weight values >>
                SetIdentifier exists << Weight routing requires set identifier >>
                SetIdentifier != "" << Set identifier cannot be empty >>
            }
        }
    }
}

rule route53_health_check_resource_path {
    Resources.*[ Type == "AWS::Route53::HealthCheck" ] {
        Properties {
            when ResourcePath exists {
                ResourcePath != "" << Health check resource path cannot be empty >>
                ResourcePath == /^\/.*/ << Resource path must start with forward slash >>
                # Avoid sensitive paths
                ResourcePath != /.*admin.*/ << Avoid admin paths in health checks >>
                ResourcePath != /.*login.*/ << Avoid login paths in health checks >>
                ResourcePath != /.*config.*/ << Avoid config paths in health checks >>
            }
        }
    }
}

rule route53_fqdn_validation {
    Resources.*[ Type == "AWS::Route53::HealthCheck" ] {
        Properties {
            when FullyQualifiedDomainName exists {
                FullyQualifiedDomainName != "" << FQDN cannot be empty >>
                FullyQualifiedDomainName == /^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$/ << FQDN must be valid domain format >>
            }
        }
    }
}

rule route53_dns_record_name_validation {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        Properties {
            Name == /^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*\.?$/ << DNS record name must be valid domain format >>
            # Avoid potentially dangerous subdomains
            Name != /.*\.local$/ << Avoid .local domains >>
            Name != /.*\.localhost$/ << Avoid localhost domains >>
        }
    }
}

rule route53_environment_isolation {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        Properties {
            when SetIdentifier exists {
                SetIdentifier == /.*-(dev|staging|production)(-.*)?$/ << Set identifiers should include environment for isolation >>
            }
        }
    }
}

# Health Check Security Configuration
rule route53_health_check_request_interval {
    Resources.*[ Type == "AWS::Route53::HealthCheck" ] {
        Properties {
            RequestInterval in [10, 30] << Use standard request intervals (Fast: 10s, Standard: 30s) >>
            when RequestInterval == 10 {
                # Fast interval is more expensive but provides quicker failover
                Properties exists << Fast interval (10s) should be justified for critical services >>
            }
        }
    }
}

rule route53_health_check_string_matching {
    Resources.*[ Type == "AWS::Route53::HealthCheck" ] {
        when Properties.Type == "HTTPS_STR_MATCH" {
            Properties {
                SearchString exists << String matching health checks must specify search string >>
                SearchString != "" << Search string cannot be empty >>
                # Avoid sensitive information in search strings
                SearchString != /.*password.*/ << Avoid sensitive terms in search strings >>
                SearchString != /.*secret.*/ << Avoid sensitive terms in search strings >>
            }
        }
    }
}

rule route53_cname_record_restrictions {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Type == "CNAME" {
            Properties {
                # CNAME records cannot coexist with other record types at the same name
                Name != /^[^.]+\.[^.]+$/ << CNAME records should not be used for apex domains >>
                ResourceRecords exists << CNAME records must have resource records >>
                ResourceRecords not empty << CNAME resource records cannot be empty >>
            }
        }
    }
}

rule route53_mx_record_security {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Type == "MX" {
            Properties {
                TTL exists << MX records should have explicit TTL >>
                TTL >= 300 << MX records should have reasonable TTL for email delivery >>
                ResourceRecords exists << MX records must have resource records >>
            }
        }
    }
}

rule route53_txt_record_validation {
    Resources.*[ Type == "AWS::Route53::RecordSet" ] {
        when Properties.Type == "TXT" {
            Properties {
                ResourceRecords exists << TXT records must have resource records >>
                ResourceRecords[*] != "" << TXT record values cannot be empty >>
                # TXT records often contain sensitive verification codes
                Comment exists << TXT records should have comments explaining their purpose >>
            }
        }
    }
}